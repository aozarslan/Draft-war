# =============================================================================
# DRAFT WAR — environment variables
#
# Copy to `.env.local` for local development. On Vercel, add the same three
# variables under Project Settings → Environment Variables.
# =============================================================================

# Supabase project URL. Safe to expose: it is in every browser request anyway.
# Supabase dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (publishable) key. Used ONLY by the browser to subscribe to Realtime.
# Row Level Security limits it to reading `rooms`, `chat_messages` and
# `characters` — it can never write game state.
# Supabase dashboard → Project Settings → API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER ONLY — it bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_, never import it from a client component.
# Supabase dashboard → Project Settings → API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Shows the in-game dev tool panel (add bot / skip auction / force battle /
# reset). Leave unset in production.
# NEXT_PUBLIC_DRAFT_WAR_DEV=1

# Lets /api/dev answer in a production deployment when the request carries a
# matching `x-dw-dev-key` header. Without it, /api/dev returns 404 in
# production no matter what. Leave unset unless you need it.
# DRAFT_WAR_DEV_KEY=some-long-random-string
